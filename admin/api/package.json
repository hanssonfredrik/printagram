    "@azure/functions": "^4.16.5",
    "@azure/storage-blob": "^12.33.0",
    "jose": "^6.2.12",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
