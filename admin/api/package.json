{
  "name": "@printagram/admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "Inbunden admin: managed Azure Functions for the separate admin Static Web App (Node 20, v4 model)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run"
  },
  "dependencies": {
